# Path to fantasy402-skills clone (graded parser + graph replay)
FANTASY402_SKILLS_ROOT=/Users/nolarose/fantasy402-skills

# Dashboard
DASHBOARD_PORT=4020
DASHBOARD_HOST=127.0.0.1
# POST /api/trigger-reload after replay (skills graph:replay + autopilot heal)
# FANTASY402_DASHBOARD_RELOAD=0
# FANTASY402_DASHBOARD_RELOAD_URL=http://127.0.0.1:4020/api/trigger-reload
# FANTASY402_DASHBOARD_RELOAD_TOKEN=

# Grok / xAI (https://console.x.ai/)
XAI_API_KEY=
XAI_MODEL=grok-4-7-fast-non-reasoning
GROK_SYSTEM_EXTRA=

# Autopilot (Bun.cron in-process poll)
FANTASY402_CRON_POLL_SCHEDULE=*/15 * * * *
FANTASY402_CRON_TZ=America/Chicago
FANTASY402_COVERAGE_ALERT_MIN=0.80

# Telegram alerting (optional; autopilot tick)
# TELEGRAM_BOT_TOKEN=   # from @BotFather
# TELEGRAM_CHAT_ID=     # user or group (-100…)
# TELEGRAM_DRY_RUN=1    # log message only, no HTTP

# Autopilot self-heal: parse pending HTML → trace when snapshot exists but trace missing
# FANTASY402_AUTOPILOT_HEAL_PARSE_PENDING=0
